generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WebsitePageView {
  id          String   @id
  day         DateTime @db.Date
  path        String   @db.VarChar(120)
  visitorHash String   @db.VarChar(64)
  device      String   @db.VarChar(10)
  referrer    String   @db.VarChar(253)
  createdAt   DateTime @default(now())

  @@index([day, visitorHash])
  @@index([day, path])
  @@map("website_page_views")
}

enum UserRole {
  ADMIN
  STAFF
  APPLICANT
  STUDENT
}

enum ApplicationStatus {
  DRAFT
  PENDING
  SUBMITTED
  REVIEWED
  RETURNED
  INTERVIEW_SCHEDULED
  ACCEPTED
  ADMITTED
  REJECTED
}

enum DocumentType {
  PASSPORT
  BIRTH_CERTIFICATE
  NATIONAL_ID
  EDUCATIONAL_RESULT
  CHANGE_OF_NAME
  PAYMENT_EVIDENCE
  OTHER
}

enum ReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentType {
  APPLICATION_FEE
  ACCEPTANCE_FEE
  SCHOOL_FEE
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(ADMIN)
  portalUsername     String?  @unique
  officialEmail      String?  @unique
  mustChangePassword Boolean  @default(false)
  sessionVersion     Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  newsItems News[]
  galleryItems Gallery[]
  application Application?
  roleAssignments UserRoleAssignment[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model AccessRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  assignments UserRoleAssignment[]

  @@map("access_roles")
}

model UserRoleAssignment {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model Application {
  id                    String            @id @default(uuid())
  isTest                Boolean           @default(false)
  applicantId           String?           @unique
  applicationNumber     String?           @unique
  formFeeAmount         Decimal?          @db.Decimal(12, 2)
  fullName              String
  surname               String?
  firstName             String?
  middleName            String?
  email                 String
  phoneNumber           String
  gender                Gender?
  dateOfBirth           DateTime?
  address               String?
  state                 String?
  lga                    String?
  nationality            String?           @default("Nigerian")
  maritalStatus          String?
  postalAddress          String?
  permanentAddress       String?
  guardianName           String?
  guardianAddress        String?
  guardianRelationship   String?
  guardianPhone          String?
  courseOfInterest      String?
  previousQualification String?
  educationRecords       Json?
  sponsorName            String?
  sponsorAddress         String?
  sponsorPhone           String?
  workExperience         Json?
  declarationAccepted    Boolean           @default(false)
  passportPath          String?
  passportFileType      String?
  passportFileSize      Int?
  status                ApplicationStatus @default(PENDING)
  reviewNote            String?
  applicationReceiptNo  String?
  interviewDate         DateTime?
  entranceExamScore     Float?
  interviewScore         Float?
  dateReceived           DateTime?
  dateResumed            DateTime?
  studentNumber          String?            @unique
  submittedAt            DateTime?
  admittedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  applicant User?                      @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  documents ApplicationDocument[]
  payments Payment[]
  statusHistory ApplicationStatusHistory[]

  @@index([status])
  @@index([email])
  @@map("applications")
}

model ApplicationDocument {
  id            String       @id @default(uuid())
  applicationId String
  type          DocumentType
  label         String
  path          String
  fileType      String
  fileSize      Int
  reviewStatus  ReviewStatus @default(PENDING)
  reviewNote    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([type])
  @@map("application_documents")
}

model Payment {
  id            String        @id @default(uuid())
  isTest        Boolean       @default(false)
  applicationId String
  type          PaymentType
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")
  reference     String
  provider      String        @default("MANUAL")
  providerTransactionId String? @unique
  checkoutUrl   String?
  checkoutStartedAt DateTime?
  proofPath     String?
  proofFileType String?
  proofFileSize Int?
  status        PaymentStatus @default(PENDING)
  reviewNote    String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
  @@index([reference])
  @@map("payments")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  changedBy     String
  createdAt     DateTime           @default(now())
  emailStatus   String             @default("NOT_REQUIRED")
  emailRecipient String?
  emailAttempts Int                @default(0)
  emailLastAttemptAt DateTime?
  emailSentAt DateTime?
  emailError String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([emailStatus, emailLastAttemptAt])
  @@map("application_status_history")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, startsAt])
  @@map("events")
}

model News {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  imagePath   String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@index([publishedAt])
  @@map("news")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  category    String
  imagePath   String
  fileType    String
  fileSize    Int
  description String?
  isPublished Boolean  @default(true)
  uploadedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublished])
  @@map("gallery")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@map("contact_messages")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}
