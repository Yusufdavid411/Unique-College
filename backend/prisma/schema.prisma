generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WebsitePageView {
  id          String   @id
  day         DateTime @db.Date
  path        String   @db.VarChar(120)
  visitorHash String   @db.VarChar(64)
  device      String   @db.VarChar(10)
  referrer    String   @db.VarChar(253)
  createdAt   DateTime @default(now())

  @@index([day, visitorHash])
  @@index([day, path])
  @@map("website_page_views")
}

enum UserRole {
  ADMIN
  STAFF
  APPLICANT
  STUDENT
}

enum ApplicationStatus {
  DRAFT
  PENDING
  SUBMITTED
  REVIEWED
  RETURNED
  INTERVIEW_SCHEDULED
  ACCEPTED
  ADMITTED
  REJECTED
}

enum DocumentType {
  PASSPORT
  BIRTH_CERTIFICATE
  NATIONAL_ID
  EDUCATIONAL_RESULT
  CHANGE_OF_NAME
  PAYMENT_EVIDENCE
  OTHER
}

enum ReviewStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentType {
  APPLICATION_FEE
  SCREENING_FEE
  ACCEPTANCE_FEE
  SCHOOL_FEE
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(ADMIN)
  portalUsername     String?  @unique
  officialEmail      String?  @unique
  mustChangePassword Boolean  @default(false)
  sessionVersion     Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  newsItems News[]
  galleryItems Gallery[]
  application Application?
  studentProfile StudentProfile?
  portalHandoffs PortalHandoff[]
  passwordReset PasswordReset?
  staffAssignments StaffStudentAssignment[]
  roleAssignments UserRoleAssignment[]
  academicAppointments AcademicAppointment[]

  @@map("users")
}

model PasswordReset {
  userId         String   @id
  tokenHash      String   @unique @db.VarChar(64)
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

model AccessRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  assignments UserRoleAssignment[]

  @@map("access_roles")
}

model UserRoleAssignment {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model Application {
  id                    String            @id @default(uuid())
  isTest                Boolean           @default(false)
  applicantId           String?           @unique
  applicationNumber     String?           @unique
  formFeeAmount         Decimal?          @db.Decimal(12, 2)
  screeningFeeAmount    Decimal?          @db.Decimal(12, 2)
  screeningStatus       String            @default("NOT_SCHEDULED")
  screeningAt           DateTime?
  screeningVenue        String?
  screeningInstructions String?
  screeningResultAt     DateTime?
  requiresAcceptanceForm Boolean          @default(true)
  acceptanceFeeAmount   Decimal?          @db.Decimal(12, 2)
  offerResponse         String            @default("PENDING")
  offerIssuedAt         DateTime?
  offerRespondedAt      DateTime?
  clearanceStatus       String            @default("PENDING")
  clearanceNote         String?
  clearedBy             String?
  clearedAt             DateTime?
  fullName              String
  surname               String?
  firstName             String?
  middleName            String?
  email                 String
  phoneNumber           String
  gender                Gender?
  dateOfBirth           DateTime?
  address               String?
  state                 String?
  lga                    String?
  nationality            String?           @default("Nigerian")
  maritalStatus          String?
  postalAddress          String?
  permanentAddress       String?
  guardianName           String?
  guardianAddress        String?
  guardianRelationship   String?
  guardianPhone          String?
  courseOfInterest      String?
  previousQualification String?
  educationRecords       Json?
  sponsorName            String?
  sponsorAddress         String?
  sponsorPhone           String?
  workExperience         Json?
  declarationAccepted    Boolean           @default(false)
  passportPath          String?
  passportFileType      String?
  passportFileSize      Int?
  status                ApplicationStatus @default(PENDING)
  reviewNote            String?
  applicationReceiptNo  String?
  interviewDate         DateTime?
  entranceExamScore     Float?
  interviewScore         Float?
  dateReceived           DateTime?
  dateResumed            DateTime?
  studentNumber          String?            @unique
  submittedAt            DateTime?
  admittedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  applicant User?                      @relation(fields: [applicantId], references: [id], onDelete: SetNull)
  documents ApplicationDocument[]
  payments Payment[]
  statusHistory ApplicationStatusHistory[]
  studentProfile StudentProfile?
  schoolForms SchoolForm[]
  admissionLetters AdmissionLetter[]

  @@index([status])
  @@index([email])
  @@map("applications")
}

model ApplicationDocument {
  id            String       @id @default(uuid())
  applicationId String
  type          DocumentType
  label         String
  path          String
  fileType      String
  fileSize      Int
  reviewStatus  ReviewStatus @default(PENDING)
  reviewNote    String?
  supersededAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([type])
  @@map("application_documents")
}

model Payment {
  id            String        @id @default(uuid())
  isTest        Boolean       @default(false)
  applicationId String
  type          PaymentType
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")
  reference     String
  provider      String        @default("MANUAL")
  providerTransactionId String? @unique
  checkoutUrl   String?
  checkoutStartedAt DateTime?
  proofPath     String?
  proofFileType String?
  proofFileSize Int?
  status        PaymentStatus @default(PENDING)
  reviewNote    String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([status])
  @@index([reference])
  @@map("payments")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?
  kind          String             @default("STATUS")
  notificationSubject String?
  notificationText String?
  changedBy     String
  createdAt     DateTime           @default(now())
  emailStatus   String             @default("NOT_REQUIRED")
  emailRecipient String?
  emailAttempts Int                @default(0)
  emailLastAttemptAt DateTime?
  emailSentAt DateTime?
  emailError String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([emailStatus, emailLastAttemptAt])
  @@map("application_status_history")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  startsAt    DateTime
  endsAt      DateTime
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, startsAt])
  @@map("events")
}

model News {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  imagePath   String?
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@index([publishedAt])
  @@map("news")
}

model Gallery {
  id          String   @id @default(uuid())
  title       String
  category    String
  imagePath   String
  fileType    String
  fileSize    Int
  description String?
  isPublished Boolean  @default(true)
  uploadedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([isPublished])
  @@map("gallery")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@map("contact_messages")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

model StudentProfile {
  id String @id @default(uuid())
  userId String @unique
  applicationId String @unique
  phoneNumber String?
  address String?
  guardianName String?
  guardianRelationship String?
  guardianPhone String?
  guardianAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  enrolments StudentEnrolment[]
  @@map("student_profiles")
}

model AcademicDepartment {
  id String @id @default(uuid())
  code String @unique
  name String
  isActive Boolean @default(true)
  programmes AcademicProgramme[]
  appointments AcademicAppointment[]
  courses AcademicCourse[]
  @@map("academic_departments")
}

model AcademicProgramme {
  id String @id @default(uuid())
  code String @unique
  name String
  departmentId String
  isActive Boolean @default(true)
  department AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  enrolments StudentEnrolment[]
  courses AcademicCourse[]
  registrationWindows CourseRegistrationWindow[]
  @@index([departmentId])
  @@map("academic_programmes")
}

model AcademicSession {
  id String @id @default(uuid())
  name String @unique
  startsAt DateTime
  endsAt DateTime
  isActive Boolean @default(true)
  enrolments StudentEnrolment[]
  courses AcademicCourse[]
  registrationWindows CourseRegistrationWindow[]
  @@map("academic_sessions")
}

model AcademicLevel {
  id String @id @default(uuid())
  code String @unique
  name String
  isActive Boolean @default(true)
  enrolments StudentEnrolment[]
  courses AcademicCourse[]
  registrationWindows CourseRegistrationWindow[]
  @@map("academic_levels")
}

model AcademicAppointment {
  id String @id @default(uuid())
  staffId String
  departmentId String?
  responsibility String
  assignedBy String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  endedAt DateTime?
  staff User @relation(fields: [staffId], references: [id], onDelete: Restrict)
  department AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  @@index([staffId, isActive])
  @@map("academic_appointments")
}

model AcademicCourse {
  id String @id @default(uuid())
  departmentId String
  programmeId String
  sessionId String
  levelId String
  semester Int
  code String
  title String
  creditUnits Int
  category String
  published Boolean @default(false)
  createdBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  department AcademicDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  programme AcademicProgramme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  level AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  registrationItems CourseRegistrationItem[]
  resultBatch CourseResultBatch?
  cbtExams CbtExam[]
  @@unique([programmeId, sessionId, levelId, semester, code])
  @@index([departmentId, sessionId])
  @@map("academic_courses")
}

model StudentEnrolment {
  id String @id @default(uuid())
  studentId String
  programmeId String
  sessionId String
  levelId String
  status String @default("ASSIGNED")
  assignedBy String
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programme AcademicProgramme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  level AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  staffAssignments StaffStudentAssignment[]
  courseRegistrations CourseRegistration[]
  @@unique([studentId, sessionId])
  @@index([programmeId])
  @@index([sessionId])
  @@index([levelId])
  @@map("student_enrolments")
}

model CourseRegistrationWindow {
  id String @id @default(uuid())
  programmeId String
  sessionId String
  levelId String
  semester Int
  opensAt DateTime
  closesAt DateTime
  minUnits Int
  maxUnits Int
  updatedAt DateTime @updatedAt
  programme AcademicProgramme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  level AcademicLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  @@unique([programmeId, sessionId, levelId, semester])
  @@map("course_registration_windows")
}

model CourseRegistration {
  id String @id @default(uuid())
  enrolmentId String
  semester Int
  status String @default("SUBMITTED")
  reviewNote String?
  submittedAt DateTime @default(now())
  reviewedBy String?
  reviewedAt DateTime?
  updatedAt DateTime @updatedAt
  enrolment StudentEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)
  items CourseRegistrationItem[]
  @@unique([enrolmentId, semester])
  @@map("course_registrations")
}

model CourseRegistrationItem {
  id String @id @default(uuid())
  registrationId String
  courseId String
  code String
  title String
  creditUnits Int
  registration CourseRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  course AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  results CourseResultEntry[]
  cbtAttempts CbtAttempt[]
  @@unique([registrationId, courseId])
  @@map("course_registration_items")
}

model CourseResultBatch {
  id String @id @default(uuid())
  courseId String @unique
  status String @default("DRAFT")
  reviewNote String?
  history Json @default("[]")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  publishedAt DateTime?
  course AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  entries CourseResultEntry[]
  @@map("course_result_batches")
}

model CourseResultEntry {
  id String @id @default(uuid())
  batchId String
  registrationItemId String
  score Decimal @db.Decimal(5, 2)
  batch CourseResultBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  registrationItem CourseRegistrationItem @relation(fields: [registrationItemId], references: [id], onDelete: Restrict)
  @@unique([batchId, registrationItemId])
  @@map("course_result_entries")
}

model CbtExam {
  id String @id @default(uuid())
  courseId String
  title String
  startsAt DateTime
  endsAt DateTime
  durationMinutes Int
  questions Json
  status String @default("DRAFT")
  resultsReleased Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course AcademicCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  attempts CbtAttempt[]
  @@map("cbt_exams")
}

model CbtAttempt {
  id String @id @default(uuid())
  examId String
  registrationItemId String
  startedAt DateTime @default(now())
  deadline DateTime
  submittedAt DateTime?
  answers Json @default("{}")
  score Decimal? @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt
  exam CbtExam @relation(fields: [examId], references: [id], onDelete: Restrict)
  registrationItem CourseRegistrationItem @relation(fields: [registrationItemId], references: [id], onDelete: Restrict)
  @@unique([examId, registrationItemId])
  @@map("cbt_attempts")
}

model StaffStudentAssignment {
  id          String @id @default(uuid())
  staffId     String
  enrolmentId String
  assignedBy  String
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       User @relation(fields: [staffId], references: [id], onDelete: Restrict)
  enrolment   StudentEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)

  @@unique([staffId, enrolmentId])
  @@index([staffId, isActive])
  @@map("staff_student_assignments")
}

model StudentAnnouncement {
  id String @id @default(uuid())
  title String
  body String
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isPublished, publishedAt])
  @@map("student_announcements")
}

model PortalHandoff {
  tokenHash String @id
  browserHash String
  userId String
  sessionVersion Int
  expiresAt DateTime
  consumedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([userId])
  @@map("portal_handoffs")
}

model SchoolForm {
  id String @id @default(uuid())
  applicationId String
  kind String
  data Json
  status String @default("DRAFT")
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  @@unique([applicationId, kind])
  @@map("school_forms")
}

model AdmissionLetter {
  id String @id @default(uuid())
  applicationId String
  version Int
  snapshot Json
  issuedAt DateTime @default(now())
  issuedBy String
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  @@unique([applicationId, version])
  @@map("admission_letters")
}
